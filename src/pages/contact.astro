---
import Layout from '../layouts/Layout.astro';
import { site } from '../../site.config.js';

const { phone, phoneHref, email, address } = site;
---

<Layout title={`Contact${site.seo.titleSuffix}`}>
  <section class="bg-[#f5f5f5] py-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

        <!-- Left: Info -->
        <div>
          <p class="font-heading font-bold text-sm tracking-widest uppercase text-[#e31937] mb-4">GET IN TOUCH</p>
          <h1 class="font-heading font-bold uppercase text-6xl md:text-7xl text-[#0a0a0a] leading-tight mb-6">
            LET'S MOVE<br />FORWARD
          </h1>
          <p class="font-body text-gray-500 text-lg leading-relaxed mb-12">
            Ready to simplify your supply chain? Our team is available 24/7/365 to discuss your logistics needs and build a custom solution for your business.
          </p>
          <div class="flex flex-col gap-6">
            {address.street && (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-[#e31937] flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-heading font-bold text-sm uppercase tracking-wider text-[#0a0a0a] mb-1">Address</p>
                  <p class="font-body text-gray-500 text-sm">{address.street}<br/>{address.city}, {address.province} {address.postal}</p>
                </div>
              </div>
            )}
            {!address.street && (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-[#e31937] flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-heading font-bold text-sm uppercase tracking-wider text-[#0a0a0a] mb-1">Location</p>
                  <p class="font-body text-gray-500 text-sm">{address.city}, {address.province}, {address.country}</p>
                </div>
              </div>
            )}
            {phone && (
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-[#e31937] flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-heading font-bold text-sm uppercase tracking-wider text-[#0a0a0a] mb-1">Phone</p>
                  <a href={phoneHref} class="font-body text-gray-500 text-sm hover:text-[#e31937] transition-colors">{phone}</a>
                </div>
              </div>
            )}
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-[#e31937] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="font-heading font-bold text-sm uppercase tracking-wider text-[#0a0a0a] mb-1">Email</p>
                <a href={`mailto:${email}`} class="font-body text-gray-500 text-sm hover:text-[#e31937] transition-colors">{email}</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <!--
          Email routing (handled by Resend API endpoint when built):
          - General Inquiry   → site.emails.general    (info@synchronlogistics.com)
          - Sales & Quotes    → site.emails.sales       (sales@synchronlogistics.com)
          - Carrier Inquiries → site.emails.accounting  (accounting@synchronlogistics.com)
          The selected inquiry type value is submitted with the form and read by the endpoint.
          Do not hardcode email strings here — always reference site.config.js.
        -->
        <div class="bg-white p-10">
          <h2 class="font-heading font-bold uppercase text-3xl text-[#0a0a0a] mb-8">GET A QUOTE</h2>
          <form id="contact-form" novalidate class="flex flex-col gap-5">
            <!-- Honeypot: display:none (skipped by browser autofill, unlike off-screen), neutral field name. Bots that fill all inputs trip it; real users never do. Submissions with this filled are silently dropped server-side. -->
            <div class="hidden" aria-hidden="true">
              <input type="text" name="contact_ref" tabindex="-1" autocomplete="off" />
            </div>
            <div>
              <label class="font-body text-xs uppercase tracking-widest text-gray-500 mb-2 block">Inquiry Type</label>
              <select
                name="inquiryType"
                class="w-full border border-gray-200 px-4 py-3 font-body text-sm focus:outline-none focus:border-[#e31937] transition-colors bg-white text-gray-700"
              >
                <option value="general">General Inquiry</option>
                <option value="sales">Sales &amp; Quotes</option>
                <option value="carrier">Carrier Inquiries</option>
              </select>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="font-body text-xs uppercase tracking-widest text-gray-500 mb-2 block">First Name</label>
                <input type="text" name="firstName" required class="w-full border border-gray-200 px-4 py-3 font-body text-sm focus:outline-none focus:border-[#e31937] transition-colors" placeholder="John" />
                <p class="hidden font-body text-xs text-[#e31937] mt-1" data-error-for="firstName"></p>
              </div>
              <div>
                <label class="font-body text-xs uppercase tracking-widest text-gray-500 mb-2 block">Last Name</label>
                <input type="text" name="lastName" required class="w-full border border-gray-200 px-4 py-3 font-body text-sm focus:outline-none focus:border-[#e31937] transition-colors" placeholder="Smith" />
                <p class="hidden font-body text-xs text-[#e31937] mt-1" data-error-for="lastName"></p>
              </div>
            </div>
            <div>
              <label class="font-body text-xs uppercase tracking-widest text-gray-500 mb-2 block">Email</label>
              <input type="email" name="email" required class="w-full border border-gray-200 px-4 py-3 font-body text-sm focus:outline-none focus:border-[#e31937] transition-colors" placeholder="john@company.com" />
              <p class="hidden font-body text-xs text-[#e31937] mt-1" data-error-for="email"></p>
            </div>
            <div>
              <label class="font-body text-xs uppercase tracking-widest text-gray-500 mb-2 block">Company</label>
              <input type="text" name="company" class="w-full border border-gray-200 px-4 py-3 font-body text-sm focus:outline-none focus:border-[#e31937] transition-colors" placeholder="Your Company" />
            </div>
            <div>
              <label class="font-body text-xs uppercase tracking-widest text-gray-500 mb-2 block">Service Needed</label>
              <select name="service" class="w-full border border-gray-200 px-4 py-3 font-body text-sm focus:outline-none focus:border-[#e31937] transition-colors bg-white text-gray-500">
                <option value="">Select a service</option>
                <option>Air Freight</option>
                <option>Ocean Freight</option>
                <option>Road Transportation</option>
                <option>Drayage</option>
                <option>Cross-Border</option>
                <option>Warehousing & Distribution</option>
                <option>E-Commerce Fulfillment</option>
                <option>Supply Chain Consulting</option>
                <option>Freight Brokerage</option>
                <option>Special / Project Cargo</option>
              </select>
            </div>
            <div>
              <label class="font-body text-xs uppercase tracking-widest text-gray-500 mb-2 block">Message</label>
              <textarea name="message" rows="4" required class="w-full border border-gray-200 px-4 py-3 font-body text-sm focus:outline-none focus:border-[#e31937] transition-colors resize-none" placeholder="Tell us about your logistics needs..."></textarea>
              <p class="hidden font-body text-xs text-[#e31937] mt-1" data-error-for="message"></p>
            </div>
            <button type="submit" data-submit class="bg-[#e31937] text-white font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 hover:bg-[#c41530] transition-colors self-start disabled:opacity-60 disabled:cursor-not-allowed">
              SEND MESSAGE
            </button>
            <p class="hidden font-body text-sm" data-form-status role="status" aria-live="polite"></p>
          </form>
        </div>

      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      const statusEl = form.querySelector('[data-form-status]') as HTMLElement;
      const button = form.querySelector('[data-submit]') as HTMLButtonElement;
      const errorEls = form.querySelectorAll<HTMLElement>('[data-error-for]');
      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      function clearErrors() {
        errorEls.forEach((el) => { el.textContent = ''; el.classList.add('hidden'); });
      }

      function showFieldError(name: string, msg: string) {
        const el = form!.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
        if (el) { el.textContent = msg; el.classList.remove('hidden'); }
      }

      function setStatus(msg: string, ok: boolean) {
        statusEl.textContent = msg;
        statusEl.classList.remove('hidden');
        statusEl.classList.toggle('text-[#e31937]', !ok);
        statusEl.classList.toggle('text-green-600', ok);
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearErrors();
        statusEl.classList.add('hidden');

        const data = Object.fromEntries(new FormData(form).entries());

        // Client-side validation (server re-validates).
        const errors: Record<string, string> = {};
        if (!String(data.firstName || '').trim()) errors.firstName = 'First name is required.';
        if (!String(data.lastName || '').trim()) errors.lastName = 'Last name is required.';
        if (!String(data.email || '').trim()) errors.email = 'Email is required.';
        else if (!EMAIL_RE.test(String(data.email))) errors.email = 'Enter a valid email address.';
        if (!String(data.message || '').trim()) errors.message = 'Message is required.';

        if (Object.keys(errors).length) {
          Object.entries(errors).forEach(([k, v]) => showFieldError(k, v));
          return;
        }

        const original = button.textContent;
        button.disabled = true;
        button.textContent = 'SENDING…';

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          const result = await res.json();
          if (res.ok && result.ok) {
            form.reset();
            setStatus(result.message || 'Message sent.', true);
          } else {
            if (result.fields) Object.entries(result.fields).forEach(([k, v]) => showFieldError(k, String(v)));
            setStatus(result.error || 'Something went wrong. Please try again.', false);
          }
        } catch {
          setStatus('Network error. Please check your connection and try again.', false);
        } finally {
          button.disabled = false;
          button.textContent = original;
        }
      });
    }
  </script>
</Layout>
